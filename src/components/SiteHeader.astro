---
import Brand from './Brand.astro';
import PixelUiIcon from './PixelUiIcon.astro';

const links = [
  ['/games/', 'Games'],
  ['/best/best-roguelikes-on-nintendo-switch/', 'Best'],
  ['/genre/action/', 'Genres'],
  ['/features/local-co-op/', 'Features'],
  ['/collections/hidden-gems/', 'Collections'],
] as const;
const section = (href: string) => `/${href.split('/')[1]}/`;
const current = section(Astro.url.pathname);
---
<header class="site-header">
  <Brand />
  <nav aria-label="Primary">
    {links.map(([href, label]) => <a href={href} aria-current={section(href) === current ? 'page' : undefined}>{label}</a>)}
  </nav>
  <form class="search" role="search" action="/games/" method="get">
    <PixelUiIcon name="search" />
    <label class="sr-only" for="site-search">Search games</label>
    <input id="site-search" type="search" name="q" placeholder="Search games" autocomplete="off" enterkeyhint="search" />
  </form>
</header>
