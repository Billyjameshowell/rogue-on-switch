---
import { Image } from 'astro:assets';
import ConsoleLogos from './ConsoleLogos.astro';
import PixelBadge from './PixelBadge.astro';
import { formatReleaseDate, games, playstyleColor } from '../data/games';
import { getGameAssetsBySiteSlug, researchFacts } from '../data/research';
const { showRelease = false, contained = false } = Astro.props as { showRelease?: boolean; contained?: boolean };
const gameAssets = await getGameAssetsBySiteSlug();
---
<div
  class:list={['table-scroll', { 'is-contained': contained }]}
  style={contained ? '--visible-rows: 5' : undefined}
  role="region"
  aria-label={contained ? 'Browse games. Scroll inside the table for more games, and sideways for more columns.' : 'Games table. Scroll sideways for more columns.'}
  tabindex="0"
>
  <table class="game-table">
    <thead><tr><th>Game</th><th>Console</th>{showRelease && <th>Released</th>}<th>Run length</th><th>Price (USD)</th><th>Genre</th><th>Playstyle</th><th>Co-op</th></tr></thead>
    <tbody>{games.map((seed) => {
      const asset = gameAssets.get(seed.slug);
      const game = researchFacts(seed, asset?.entry) ?? seed;
      return <tr>
        <td><a class="game-cell" href={`/games/${game.slug}/`}>{asset?.cover && <Image class="game-thumbnail" src={asset.cover} width={104} height={60} alt="" />}<span>{game.title}</span></a></td>
        <td><ConsoleLogos consoles={game.consoles} /></td>
        {showRelease && <td><time datetime={game.releaseDate}>{formatReleaseDate(game.releaseDate)}</time></td>}
        <td>{game.runLength}</td><td>{game.price}</td><td>{game.genre}, {game.classification}</td>
        <td><PixelBadge label={game.playstyle} color={playstyleColor[game.playstyle]} /></td><td>{game.coOp}</td>
      </tr>;
    })}</tbody>
  </table>
</div>
<p class="table-note">{contained && 'Scroll the table for the full list. '}Every Switch game here also plays on Switch 2. A Switch 2 logo marks a Switch 2 game or a Switch 2 Edition.</p>
{contained && <script>
  for (const el of document.querySelectorAll('.table-scroll.is-contained')) {
    el.addEventListener('keydown', (event) => {
      if (event.target !== el) return;
      const line = Number.parseFloat(getComputedStyle(el).getPropertyValue('--table-row')) || 43;
      const page = el.clientHeight - (Number.parseFloat(getComputedStyle(el).getPropertyValue('--table-head')) || 0);
      const distance = event.key === 'ArrowDown' ? line
        : event.key === 'ArrowUp' ? -line
        : event.key === 'PageDown' ? page
        : event.key === 'PageUp' ? -page
        : event.key === 'Home' ? -el.scrollHeight
        : event.key === 'End' ? el.scrollHeight
        : 0;
      if (!distance) return;
      event.preventDefault();
      el.scrollBy({ top: distance });
    });
  }
</script>}
