---
import { Image } from 'astro:assets';
import ConsoleLogos from './ConsoleLogos.astro';
import PixelBadge from './PixelBadge.astro';
import { formatReleaseDate, playstyleColor } from '../data/games';
import { genreLine, getDirectory } from '../data/directory';

type Props = { showRelease?: boolean };
const { showRelease = false } = Astro.props;
const directory = await getDirectory();
---
<div class="table-scroll" role="region" aria-label="Games table. Scroll sideways for more columns." tabindex="0">
  <table class="game-table">
    <thead><tr><th scope="col">Game</th><th scope="col">Console</th>{showRelease && <th scope="col">Released</th>}<th scope="col">Run length</th><th scope="col">Price (USD)</th><th scope="col">Genre</th><th scope="col">Playstyle</th><th scope="col">Co-op</th></tr></thead>
    <tbody>{directory.map((game) => (
      <tr data-search={[game.title, game.genre, game.classification, game.playstyle, game.coOp === 'No' ? '' : 'co-op'].join(' ').toLowerCase()}>
        <th scope="row"><a class="game-cell" href={`/games/${game.slug}/`}>{game.cover && <Image class="game-thumbnail" src={game.cover} width={104} height={60} alt="" />}<span>{game.title}</span></a></th>
        <td><ConsoleLogos consoles={game.consoles} /></td>
        {showRelease && <td><time datetime={game.releaseDate}>{formatReleaseDate(game.releaseDate)}</time></td>}
        <td>{game.runLength}</td><td>{game.price}</td><td>{genreLine(game)}</td>
        <td><PixelBadge label={game.playstyle} color={playstyleColor[game.playstyle]} /></td><td>{game.coOp}</td>
      </tr>
    ))}</tbody>
  </table>
</div>
<p class="table-note">Every Switch game here also plays on Switch 2. A Switch 2 logo marks a Switch 2 game or a Switch 2 Edition.</p>
