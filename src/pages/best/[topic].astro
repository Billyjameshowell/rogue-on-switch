---
import HubPage from '../../components/HubPage.astro';
import { getDirectory } from '../../data/directory';
import { guides } from '../../data/hubs';

export function getStaticPaths() { return guides.map((guide) => ({ params: { topic: guide.slug }, props: { guide } })); }
const { guide } = Astro.props;
const picks = guide.picks(await getDirectory());
---
<HubPage section={['Best']} title={guide.title} description={guide.description} picks={picks} ranked />
