---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CrossLinks from '../../components/CrossLinks.astro';
import GameCards from '../../components/GameCards.astro';
import { games } from '../../data/games';
import { directoryPlan, documentTitle, guides, plain, platformName } from '../../lib/hubs.mjs';
import { siteOrigin } from '../../lib/site';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { topic: guide.slug } }));
}

const topic = Astro.params.topic!;
const model = directoryPlan(games).guide(topic);
const first = model.picks[0];
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Best', href: '/best/best-roguelikes-on-nintendo-switch/' },
  { name: model.h1 },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: model.h1,
  itemListElement: model.picks.map((game, position) => ({
    '@type': 'ListItem',
    position: position + 1,
    name: game.title,
    url: `${siteOrigin}/games/${game.slug}/`,
  })),
};
---
<BaseLayout title={documentTitle(model.h1)} description={model.description} crumbs={crumbs}>
  <SiteHeader />
  <main class="shell">
    <Breadcrumb crumbs={crumbs} />
    <article class="detail">
      <p class="kicker">Editorial guide</p>
      <h1>{model.h1}</h1>
      <p>
        {model.picks.length} games are on this list.
        It opens with <a href={`/games/${first.slug}/`}>{first.title}</a>, a {first.classification.toLowerCase()} on {platformName(first)} listed at {plain(first.price)} with runs of {plain(first.runLength)}.
      </p>
      <h2>{model.question}</h2>
      <p>{model.answer(first)}</p>
      <CrossLinks links={model.links} />
      <GameCards picks={model.picks} />
    </article>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
