---
import { getImage } from 'astro:assets';
import hero from '../assets/pixel-dungeon-gate-roguelike-homepage.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import PixelIcon from '../components/PixelIcon.astro';
import PixelButton from '../components/PixelButton.astro';
import PixelBadge from '../components/PixelBadge.astro';
import GuidanceMark from '../components/GuidanceMark.astro';
import PixelUiIcon from '../components/PixelUiIcon.astro';
import { Image } from 'astro:assets';
import { games } from '../data/games';
import { getGameAssetsBySiteSlug, researchFacts } from '../data/research';
import { directoryPlan, documentTitle, plain } from '../lib/hubs.mjs';

const plan = directoryPlan(games);
const styles = [
  ['Action', 'action', 'Fast reflexes, close combat, pure adrenaline.'],
  ['Cards', 'cards', 'Deckbuilding and tactical card combat.'],
  ['Tactics', 'tactics', 'Grid-based strategy and careful planning.'],
  ['Shooter', 'shooter', 'Guns, bullets, and screen-clearing chaos.'],
  ['Co-op', 'coop', 'Team up with friends for chaotic co-op runs.'],
] as const;
const color = { Action: 'var(--action)', Cards: 'var(--cards)', Tactics: 'var(--tactics)', Shooter: 'var(--shooter)', 'Co-op': 'var(--coop)' };
const gameAssets = await getGameAssetsBySiteSlug();
const featured = games.slice(0, 5);
const socialImage = (await getImage({ src: hero, width: 1200, format: 'jpg' })).src;
const description = 'Independent guides to roguelikes and roguelites on Nintendo Switch, with run length, US price, co-op, and who each game suits.';
---
<BaseLayout title={documentTitle('Roguelikes on Nintendo Switch')} description={description} image={socialImage}>
  <SiteHeader />
  <main class="shell">
    <section class="hero">
      <div>
        <h1>Find your next<br />roguelike on<br /><em>Nintendo Switch.</em></h1>
        <p>Rogue On Switch is an independent directory of roguelikes and roguelites you can play on Nintendo Switch. The lists sort games by how a run feels, what it costs, and whether a second player can join.</p>
        <PixelButton href="#browse" label="Explore games" />
      </div>
      <div class="hero-art" aria-label="Pixel-art illustration of an explorer standing at a ruined dungeon gate, the homepage art for Rogue On Switch."></div>
    </section>
    <section class="section">
      <p class="kicker">Browse by playstyle</p>
      <div class="playstyles">
        {styles.map(([name, icon, copy]) => (
          <a class="playstyle" href={`/genre/${name.toLowerCase()}/`} style={`--color:${color[name]}`}>
            <PixelIcon name={icon} label={`${name} playstyle`} />
            <b>{name}</b>
            <span>{copy}</span>
          </a>
        ))}
      </div>
    </section>
    <section class="section">
      <p class="kicker">Editor's pick</p>
      <div class="feature">
        <div class="feature-visual"><p class="feature-title">Hades</p></div>
        <div class="feature-copy">
          <h2><a href="/games/hades/">Hades on Nintendo Switch</a></h2>
          <p>Supergiant's action roguelite. You fight out of the Greek Underworld, and the story plus the upgrades continue across failed escapes. The regular US price is $24.99.</p>
          <PixelBadge label="Action" color="var(--action)" />
        </div>
        <div class="feature-guidance">
          <div>
            <h3>Best for</h3>
            <p>
              <GuidanceMark />Players who want fast combat and a story that keeps going<br />
              <GuidanceMark />Players who like permanent upgrades between runs<br />
              <GuidanceMark />Anyone who wants the run to move a larger plot forward
            </p>
          </div>
          <div>
            <h3 class="skip">Skip if</h3>
            <p>
              <GuidanceMark variant="cross" />You prefer turn-based or slow combat<br />
              <GuidanceMark variant="cross" />You want long planning between rooms<br />
              <GuidanceMark variant="cross" />You do not want to restart after a failed escape
            </p>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="browse">
      <div class="directory-head">
        <p class="kicker">Browse games</p>
        <div class="filters">
          {plan.home.filters.map((filter) => (
            <a class="filter" href={filter.href}>{filter.anchor}</a>
          ))}
        </div>
      </div>
      <table class="game-table">
        <thead><tr><th>Game</th><th>Run length</th><th>Price (USD)</th><th>Genre</th><th>Playstyle</th><th>Co-op</th></tr></thead>
        <tbody>
          {featured.map((seed) => {
            const asset = gameAssets.get(seed.slug);
            const game = researchFacts(seed, asset?.entry) ?? seed;
            return (
              <tr>
                <td>
                  <a class="game-cell" href={`/games/${game.slug}/`}>
                    {asset?.cover && <Image class="game-thumbnail" src={asset.cover} width={104} height={60} alt="" loading="lazy" decoding="async" />}
                    <span>{game.title}</span>
                  </a>
                </td>
                <td>{plain(game.runLength)}</td>
                <td>{plain(game.price)}</td>
                <td>{plain(game.genre).toLowerCase().includes(game.classification.toLowerCase()) ? plain(game.genre) : `${plain(game.genre)}, ${game.classification}`}</td>
                <td><PixelBadge label={game.playstyle} color={color[game.playstyle]} /></td>
                <td>{plain(game.coOp)}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p>Showing {featured.length} featured games from the directory of {games.length}.</p>
    </section>
    <section class="section">
      <div class="field-guide">
        <div>
          <PixelUiIcon name="book-open" label="Open field guide" />
          <p class="kicker">The field guide</p>
          <h2>Useful answers, not store copy.</h2>
          <p>
            Also open
            {plan.home.more.map((item, index) => (
              <>
                {index === 0 ? ' ' : index + 1 === plan.home.more.length ? ', and ' : ', '}
                <a href={item.href}>{item.anchor}</a>
              </>
            ))}.
          </p>
        </div>
        {plan.home.cards.map((card) => (
          <div>
            <h3><a href={card.href}>{card.anchor}</a></h3>
            <p>{card.description}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <footer class="footer">
    <a class="brand" href="/"><strong>ROGUE</strong><span>ON SWITCH</span></a>
    <p>Rogue On Switch is an independent editorial directory and is not affiliated with, endorsed by, or sponsored by any game developer, publisher, or platform holder.</p>
    <span>About　 Contact　 Editorial Policy　 Privacy</span>
  </footer>
</BaseLayout>
