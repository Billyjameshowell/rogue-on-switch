---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { consoleNames, formatReleaseDate, games } from '../../data/games';
import { getDirectory } from '../../data/directory';

export function getStaticPaths() { return games.map((game) => ({ params: { slug: game.slug } })); }
const directory = await getDirectory();
const game = directory.find((item) => item.slug === Astro.params.slug)!;
const { research, cover } = game;
const socialImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
const { Content } = research ? await render(research) : { Content: undefined };
const related = directory.filter((item) => item.playstyle === game.playstyle && item.slug !== game.slug).slice(0, 3);
const facts = [
  ['Type', `${game.classification}, ${game.playstyle}`],
  ['Typical run', game.runLength],
  ['Regular US price', game.price],
  ['Co-op', game.coOp],
  ['Nintendo release', formatReleaseDate(game.releaseDate)],
  ...(research ? [['Players', research.data.players], ['Developer', research.data.developer]] : []),
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'VideoGame', name: game.title, genre: game.genre, gamePlatform: game.consoles.map((console) => consoleNames[console]), description: game.summary };
---
<BaseLayout title={`${game.title} on Nintendo Switch | Rogue On Switch`} description={game.summary} image={socialImage}>
  <Breadcrumb trail={[['Games', '/games/'], [game.title]]} />
  <article class="detail">
    <div class:list={['game-detail-hero', { 'has-cover': Boolean(cover) }]}>
      <div><h1>{game.title}</h1><p>{game.summary}</p></div>
      {cover && <Image src={cover} widths={[480, 960]} sizes="(max-width: 760px) 100vw, 40vw" alt={`${game.title} cover art`} loading="eager" fetchpriority="high" />}
    </div>
    <dl class="facts">{facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    {Content && <section class="research-overview"><h2>Overview</h2><Content /></section>}
    {(game.bestFor || game.skipIf) && <section><h2>Is it right for you?</h2>{game.bestFor && <p><strong>Best for:</strong> {game.bestFor}</p>}{game.skipIf && <p><strong>Skip if:</strong> {game.skipIf}</p>}</section>}
    {game.progression && <section><h2>What carries between runs</h2><p>{game.progression}</p></section>}
    {game.switchNotes && <section><h2>On {game.consoles.includes('switch') ? 'Switch' : 'Switch 2'}</h2><p>{game.switchNotes}</p></section>}
    <p class="sources">Facts checked {game.lastChecked} · <a href={game.sourceUrl}>Nintendo eShop listing</a>{research && <> · <a href={research.data.official_website}>Official site</a> · <a href={research.data.image_source}>Cover source</a></>}</p>
    {related.length > 0 && <section><h2>Try next</h2><ul class="related">{related.map((item) => <li><a href={`/games/${item.slug}/`}><b>{item.title}</b><p>{item.playstyle} · {item.runLength}</p></a></li>)}</ul></section>}
  </article>
  <script slot="end" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
