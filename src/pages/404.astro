---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelButton from '../components/PixelButton.astro';
---
<BaseLayout title="Page not found | Rogue On Switch" description="This page is not in the Rogue On Switch directory." noindex>
  <section class="detail">
    <h1>This run ended early.</h1>
    <p>The page you wanted is not here. It may have moved, or the game may have left the directory.</p>
    <PixelButton href="/games/" label="Browse all games" />
  </section>
</BaseLayout>
