---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CrossLinks from '../../components/CrossLinks.astro';
import GameCards from '../../components/GameCards.astro';
import { games } from '../../data/games';
import { directoryPlan, documentTitle, features, plain, platformName } from '../../lib/hubs.mjs';

export function getStaticPaths() {
  return features.map((feature) => ({ params: { slug: feature.slug } }));
}

const model = directoryPlan(games).feature(Astro.params.slug!);
const first = model.picks[0];
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Features', href: '/features/local-co-op/' },
  { name: model.h1 },
];
---
<BaseLayout title={documentTitle(model.h1)} description={model.description} crumbs={crumbs}>
  <SiteHeader />
  <main class="shell">
    <Breadcrumb crumbs={crumbs} />
    <article class="detail">
      <p class="kicker">Find by need</p>
      <h1>{model.h1}</h1>
      <p>
        {model.picks.length} games match this filter.
        The list opens with <a href={`/games/${first.slug}/`}>{first.title}</a>, a {first.classification.toLowerCase()} on {platformName(first)} listed at {plain(first.price)} with runs of {plain(first.runLength)}.
      </p>
      <h2>{model.question}</h2>
      <p>{first.title} is first in this set of {model.picks.length}. The co-op field says {plain(first.coOp)}, and a listed run is {plain(first.runLength)}.</p>
      <CrossLinks links={model.links} />
      <GameCards picks={model.picks} />
    </article>
  </main>
</BaseLayout>
