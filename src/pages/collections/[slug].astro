---
import HubPage from '../../components/HubPage.astro';
import { getDirectory } from '../../data/directory';
import { collections } from '../../data/hubs';

export function getStaticPaths() { return collections.map((hub) => ({ params: { slug: hub.slug }, props: { hub } })); }
const { hub } = Astro.props;
const picks = hub.picks(await getDirectory());
---
<HubPage section={['Collections']} title={hub.title} description={hub.description} picks={picks} />
