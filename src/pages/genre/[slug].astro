---
import HubPage from '../../components/HubPage.astro';
import { getDirectory } from '../../data/directory';
import { playstyles } from '../../data/hubs';

export function getStaticPaths() { return playstyles.map((style) => ({ params: { slug: style.slug }, props: { style } })); }
const { style } = Astro.props;
const picks = (await getDirectory()).filter((game) => game.playstyle === style.name);
const description = `${style.blurb} The directory has ${picks.length} ${style.name.toLowerCase()} roguelikes and roguelites on Switch, each with its run length and price.`;
---
<HubPage section={['Genres']} title={`${style.name} runs on Switch`} metaTitle={`Best ${style.name} roguelikes on Nintendo Switch | Rogue On Switch`} description={description} picks={picks} />
