---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CrossLinks from '../../components/CrossLinks.astro';
import GameCards from '../../components/GameCards.astro';
import { games } from '../../data/games';
import { directoryPlan, documentTitle, genres, plain, platformName } from '../../lib/hubs.mjs';

export function getStaticPaths() {
  return genres.map((genre) => ({ params: { slug: genre.slug } }));
}

const model = directoryPlan(games).genre(Astro.params.slug!);
const first = model.picks[0];
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Genres', href: '/genre/action/' },
  { name: model.h1 },
];
---
<BaseLayout title={documentTitle(model.h1)} description={model.description} crumbs={crumbs}>
  <SiteHeader />
  <main class="shell">
    <Breadcrumb crumbs={crumbs} />
    <article class="detail">
      <p class="kicker">Genre hub</p>
      <h1>{model.h1}</h1>
      <p>
        {model.picks.length} {model.playstyle.toLowerCase()} games are in the directory.
        The list opens with <a href={`/games/${first.slug}/`}>{first.title}</a>, a {first.classification.toLowerCase()} on {platformName(first)} listed at {plain(first.price)} with runs of {plain(first.runLength)}.
      </p>
      <h2>{model.question}</h2>
      <p>{model.picks.length} games use the {model.playstyle.toLowerCase()} playstyle. {first.title} is the first of them in the directory.</p>
      <CrossLinks links={model.links} />
      <GameCards picks={model.picks} />
    </article>
  </main>
</BaseLayout>
